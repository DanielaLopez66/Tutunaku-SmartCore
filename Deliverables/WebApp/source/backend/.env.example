# ============================================
# Tutunaku Backend - Environment Variables
# Copia este archivo como .env y configura tus valores
# ============================================

# -- Aplicación --
APP_NAME="Tutunaku API"
APP_VERSION="1.0.0"
DEBUG=true
SECRET_KEY=tu_super_secreto_cambiar_en_produccion_min_32_chars
ENVIRONMENT=development

# -- Base de datos (elegir una opción) --
DB_TYPE=both  # mysql | mongodb | both

# MySQL
# NOTA: el nombre de la base de datos se mantiene como "tutunakun_db" por
# compatibilidad con instalaciones existentes (rebrand del proyecto a
# "Tutunaku" en 2026-07-31). Si quieres renombrar la BD físicamente, crea el
# esquema nuevo con database/warehouse o schema.sql apuntando a otro nombre y
# actualiza este valor manualmente; no se migra de forma automática.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=tu_password_mysql
MYSQL_DATABASE=tutunakun_db

# MongoDB (Atlas o local)
MONGODB_URL=mongodb+srv://usuario:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=tutunakun_db

# -- JWT --
JWT_SECRET_KEY=otro_secreto_jwt_muy_largo_y_seguro_minimo_32_chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# -- Email (para verificación y recuperación) --
MAIL_USERNAME=tu_email@gmail.com
MAIL_PASSWORD=tu_app_password
MAIL_FROM=noreply@tutunaku.mx
MAIL_PORT=587
MAIL_SERVER=smtp.gmail.com
MAIL_TLS=true
MAIL_SSL=false

# -- Frontend URL (para CORS y emails) --
FRONTEND_URL=http://localhost:5173

# -- Rate Limiting --
RATE_LIMIT_PER_MINUTE=60

# -- Subida de archivos --
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10

# -- Machine Learning (/api/ml) --
# Opcional: por defecto apuntan a models/serialized y database/warehouse en
# la raíz del repositorio. Descomenta solo si necesitas rutas distintas.
# ML_MODEL_DIR=C:/ruta/a/models/serialized
# ML_WAREHOUSE_DB=C:/ruta/a/database/warehouse/tutunaku_dw.sqlite

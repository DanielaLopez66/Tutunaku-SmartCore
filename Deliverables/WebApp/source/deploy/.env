# ============================================
# Tutunaku - Variables del stack de despliegue (docker-compose)
# Copia como `.env` en esta misma carpeta (deploy/) y reemplaza los valores.
# NO subas el `.env` real a Git.
# ============================================

# Dominio real que apunta (registro DNS A) a la IP pública de este servidor.
# Debe coincidir con TrustedHostMiddleware en backend/app/main.py.
# En local (sin dominio real): localhost, con un certificado autofirmado
# para "localhost" cargado en el volumen certbot_certs (ver DeployManual §7).
DOMAIN=localhost

# -- MySQL --
MYSQL_ROOT_PASSWORD=12345
MYSQL_DATABASE=tutunakun_db
MYSQL_USER=tutunaku_app
MYSQL_PASSWORD=12345

# -- Secretos de la aplicación (genera valores aleatorios de 32+ caracteres) --
# Ejemplo para generarlos: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=taniabrandondaniela12345
JWT_SECRET_KEY=danielabrandontania12345

# -- Email (sandbox de Mailtrap: los correos NO salen a destinatarios reales,
# quedan capturados en tu inbox de mailtrap.io — ideal para probar el flujo
# de verificación de cuenta sin arriesgar enviar a un correo real) --
MAIL_USERNAME=35055fb216fa6e
MAIL_PASSWORD=e5aa4fac3b5efa
MAIL_FROM=noreply@tutunaku.mx
MAIL_PORT=2525
MAIL_SERVER=sandbox.smtp.mailtrap.io
MAIL_TLS=true
MAIL_SSL=false
